<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Freight Automation</title>

    <link href="~/Content/bootstrap.min.css"
          rel="stylesheet" />

    <link href="~/Content/Site.css"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f7fb;
        }

        /* =====================================
           SIDEBAR
           ===================================== */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 250px;
            background-color: #172033;
            color: white;
            z-index: 1000;
            overflow-y: auto;
        }


        /* =====================================
           LOGO
           ===================================== */

        .sidebar-logo {
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #007bff;
            border-radius: 8px;
            margin-right: 10px;
            font-size: 20px;
        }

        .logo-text {
            color: white;
            font-size: 17px;
            font-weight: bold;
        }


        /* =====================================
           MENU TITLE
           ===================================== */

        .sidebar-title {
            padding: 22px 20px 8px;
            font-size: 11px;
            color: #8d98aa;
            text-transform: uppercase;
            letter-spacing: 1px;
        }


        /* =====================================
           MENU
           ===================================== */

        .sidebar-menu {
            padding: 0 12px;
            margin: 0;
            list-style: none;
        }

            .sidebar-menu li {
                list-style: none;
                margin: 4px 0;
            }

                .sidebar-menu li a {
                    display: flex;
                    align-items: center;
                    width: 100%;
                    padding: 12px 14px;
                    color: #cbd3df;
                    text-decoration: none;
                    border-radius: 7px;
                    font-size: 14px;
                    transition: all 0.2s ease;
                }

                    .sidebar-menu li a:hover {
                        background-color: #243149;
                        color: white;
                        text-decoration: none;
                    }

                    .sidebar-menu li a.active {
                        background-color: #007bff;
                        color: white;
                    }

        .menu-icon {
            width: 30px;
            font-size: 17px;
        }


        /* =====================================
           LOGOUT
           ===================================== */

        .logout-menu {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }


        /* =====================================
           MAIN AREA
           ===================================== */

        .main-area {
            margin-left: 250px;
            min-height: 100vh;
            width: calc(100% - 250px);
        }


        /* =====================================
           TOP HEADER
           ===================================== */

        .top-header {
            height: 70px;
            background-color: white;
            border-bottom: 1px solid #e3e7ed;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.03);
        }

        .page-title {
            font-size: 20px;
            font-weight: 600;
            color: #202938;
        }


        /* =====================================
           ADMIN
           ===================================== */

        .admin-area {
            display: flex;
            align-items: center;
        }

        .admin-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: #eaf3ff;
            color: #007bff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 10px;
        }

        .admin-name {
            color: #333;
            font-size: 14px;
            font-weight: 600;
        }


        /* =====================================
           CONTENT
           ===================================== */

        .content-area {
            padding: 30px;
        }


        /* =====================================
           FOOTER
           ===================================== */

        .footer {
            padding: 20px 30px;
            text-align: center;
            color: #8993a4;
            font-size: 12px;
        }


        /* =====================================
           MOBILE
           ===================================== */

        .mobile-header {
            display: none;
        }

        @@media (max-width: 768px) {

            .sidebar {
                transform: translateX(-250px);
                transition: transform 0.3s ease;
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .main-area {
                margin-left: 0;
                width: 100%;
            }

            .mobile-header {
                display: flex;
                height: 60px;
                background-color: #172033;
                color: white;
                align-items: center;
                padding: 0 15px;
            }

            .mobile-menu-button {
                background: none;
                border: none;
                color: white;
                font-size: 24px;
                margin-right: 15px;
                cursor: pointer;
            }

            .content-area {
                padding: 20px 15px;
            }
        }
    </style>

</head>

<body>


    <!-- =====================================
         SIDEBAR
         ===================================== -->

    <aside class="sidebar" id="sidebar">

        <div class="sidebar-logo">

            <div class="logo-icon">
                
            </div>

            <div class="logo-text">
                Freight Automation
            </div>

        </div>


        <div class="sidebar-title">
            Main Menu
        </div>


        <ul class="sidebar-menu">

           

            <li>
                <a href="@Url.Action("UploadExcel", "FreightAuto")">

                    <span class="menu-icon">
                        
                    </span>

                    <span>
                        Upload Excel
                    </span>

                </a>
            </li>



        </ul>




        <div class="sidebar-title">
            Account
        </div>


        <ul class="sidebar-menu">

            <li>
                <a href="@Url.Action("Logout", "AdminLogin")">
                    <span class="menu-icon"></span>
                    <span>Logout</span>
                </a>
            </li>

        </ul>

    </aside>


    <!-- =====================================
         MAIN AREA
         ===================================== -->

    <div class="main-area">


        <!-- MOBILE HEADER -->

        <div class="mobile-header">

            <button class="mobile-menu-button"
                    onclick="toggleSidebar()">

                

            </button>

            <strong>
                Freight Automation
            </strong>

        </div>


        <!-- TOP HEADER -->

        <header class="top-header">

            <div class="page-title">

                @ViewBag.Title

            </div>


            <div class="admin-area">

                <div class="admin-icon">
                    A
                </div>

                <div class="admin-name">
                    Admin
                </div>

            </div>

        </header>


        <!-- =====================================
             THIS IS WHERE YOUR CURRENT PAGE LOADS
             ===================================== -->

        <main class="content-area">

            @RenderBody()

        </main>


        <footer class="footer">

            © @DateTime.Now.Year Freight Automation System

        </footer>

    </div>


    <script src="~/Scripts/jquery-1.10.2.min.js"></script>

    <script src="~/Scripts/bootstrap.min.js"></script>


    <script>

        function toggleSidebar() {

            var sidebar =
                document.getElementById("sidebar");

            sidebar.classList.toggle("show");

        }

    </script>


    @RenderSection("scripts", required: false)

</body>
</html>